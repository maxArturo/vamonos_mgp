<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.vamonos_mgp">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The FOREGROUND_SERVICE permission is required for displaying a user's location
        in the map, relative to their stops.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
</manifest>
